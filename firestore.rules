rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ผู้ใช้ที่ล็อกอินแล้วเท่านั้นที่สามารถอ่านและเขียนข้อมูลห้องพัก/ธุรกรรมของตนเองได้
    match /artifacts/condo-rental/users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ปิดการเข้าถึง path อื่นๆ ทั้งหมด (deny-by-default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
